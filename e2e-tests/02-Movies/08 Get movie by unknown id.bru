meta {
  name: Get movie by unknown id
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/movies/999999999
  body: none
  auth: none
}

tests {
  test("a movie id that was never created returns 404 with the standard error shape", function () {
    expect(res.status).to.equal(404);
    expect(res.body.code).to.equal("NOT_FOUND");
    expect(res.body.message).to.be.a("string").and.not.empty;
  });
}

docs {
  # Get movie by unknown id
  
  Negative-path check, always safe to run standalone: `999999999` is never a real
  movie id.
}
