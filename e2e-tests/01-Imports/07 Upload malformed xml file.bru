meta {
  name: Upload malformed xml file
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/imports
  body: multipartForm
  auth: none
}

body:multipart-form {
  file: @file(fixtures/invalid-not-well-formed.xml)
}

script:post-response {
  const TERMINAL = ["COMPLETED", "FAILED"];
  const MAX_ATTEMPTS = 40;
  const WAIT_MS = 250;
  
  // Different Bruno/CLI versions expose the response body under `.data` or `.body`.
  const unwrap = (response) => response && response.data === undefined ? 
        response && response.body : response.data;
  
  let task = res.body;
  const importId = task.id;
  bru.setVar("importId", importId);
  const requestConfig = {
    method: "GET",
    url: `${bru.getEnvVar("baseUrl")}/imports/${importId}`
  };
  
  let attempts = 0;
  while (!TERMINAL.includes(task.status) && attempts < MAX_ATTEMPTS) {
    await bru.sleep(WAIT_MS);
    const response = await bru.sendRequest(requestConfig);
    task = unwrap(response);
    attempts++;
  }
  
  bru.setVar("malformedImportStatus", task.status);
  bru.setVar("malformedImportError", task.error);
}

tests {
  test("the task fails rather than getting stuck, even though the XML cannot be parsed at all", function () {
    expect(bru.getVar("malformedImportStatus")).to.equal("FAILED");
  });
  
  test("the task reports a non-blank error message", function () {
    expect(bru.getVar("malformedImportError")).to.be.a("string").and.not.empty;
  });
}

docs {
  # Upload malformed xml file
  
  Uploads a file that is not even well-formed XML (an unclosed tag). The parser
  cannot build a document from it at all, so this exercises a different failure
  path than schema validation: the task should still end up `FAILED` with a
  descriptive error rather than the async pipeline getting stuck or the request
  itself erroring out.
}
