<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fixture: three distinct, well-formed movies exercising every optional field
  (genres, actors, description) at least once. Used by the "happy path" import test.

  NOTE: This file is static, so re-running the E2E suite against a database that
  already contains these movies (title + director + release year) will simply skip
  them as duplicates (recordCount 0 on the JSON response) rather than fail the
  import - see ImportWriter#persistIfNew in the backend. Tests assert the task
  reaches COMPLETED with a non-negative record count instead of an exact count, so
  the suite stays green whether it is run once or a hundred times.
-->
<movies>
    <movie>
        <title>E2E Multi Movie One</title>
        <releaseYear>2001</releaseYear>
        <durationMinutes>120</durationMinutes>
        <genres>
            <genre>Drama</genre>
            <genre>Mystery</genre>
        </genres>
        <director id="e2e-director-1">E2E Director One</director>
        <actors>
            <actor id="e2e-actor-1">E2E Actor One</actor>
            <actor id="e2e-actor-2">E2E Actor Two</actor>
        </actors>
        <description>A movie used purely to exercise the E2E import pipeline.</description>
    </movie>
    <movie>
        <title>E2E Multi Movie Two</title>
        <releaseYear>2010</releaseYear>
        <durationMinutes>95</durationMinutes>
        <genres>
            <genre>Comedy</genre>
        </genres>
        <director id="e2e-director-2">E2E Director Two</director>
        <actors>
            <actor id="e2e-actor-2">E2E Actor Two</actor>
        </actors>
    </movie>
    <movie>
        <title>E2E Multi Movie Three</title>
        <releaseYear>2019</releaseYear>
        <director id="e2e-director-1">E2E Director One</director>
    </movie>
</movies>
