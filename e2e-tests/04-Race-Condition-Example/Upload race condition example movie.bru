meta {
  name: Upload race condition example movie
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/imports
  body: multipartForm
  auth: none
}

body:multipart-form {
  file: @file(fixtures/race-condition-example.xml)
}

tests {
  test("each individual upload is still accepted and queued", function () {
    // This is deliberately the only assertion made per run: when this request is
    // fired twice concurrently (see this folder's docs/README), exactly which of
    // the two later succeeds or fails is a race, not something a single request's
    // own test script can predict.
    expect(res.status).to.equal(202);
    expect(res.body.status).to.equal("QUEUED");
  });
}

docs {
  # Upload race condition example movie

  See `04-Race-Condition-Example`'s docs / the e2e-tests README for how to fire two
  concurrent runs of this exact request against a brand-new movie, and how to
  inspect the outcome afterwards. This file alone, run once, is not the race demo -
  it is just the request the demo fires twice in parallel.
}
